  },
  "dependencies": {
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.1",
    "@tabler/icons-react": "^3.0.0",
    "bpmn-elements": "18.1.1",
    "bpmn-engine": "26.0.5",
    "bpmn-moddle": "10.3.1",
    "debug": "4.4.3",
    "jose": "^6.2.12",
    "moddle-context-serializer": "6.0.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "smqp": "15.0.0",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-react": "^5.0.0",
    "prettier": "^3.9.10",
    "typescript": "~5.9.0",
    "vite": "^7.1.0"

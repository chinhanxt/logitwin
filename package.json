{
  "name": "dxos-logistics-prototype",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24.14"
  },
  "scripts": {
    "dev": "node config/dev.mjs",
    "dev:portal": "vite --host 127.0.0.1 --port 5190 --strictPort",
    "dev:core": "node --experimental-strip-types src/core/server.ts",
    "build": "tsc --noEmit && vite build",
